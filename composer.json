{
    "name": "elkuku/symfony-utils",
    "description": "Various Symfony Utilities",
    "type": "library",
    "authors": [
        {
            "name": "Nikolai Plath",
            "email": "der.el.kuku@gmail.com"
        }
    ],
    "license": "WTFPL",
    "autoload": {
        "psr-4": {
            "Elkuku\\SymfonyUtils\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Elkuku\\SymfonyUtils\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1"
    },
    "suggest": {
        "symfony/console": "For UserAdminBaseCommand",
        "symfony/security-core": "For UserAdminBaseCommand",
        "doctrine/orm": "For UserAdminBaseCommand",
        "doctrine/doctrine-bundle": "For UserAdminBaseCommand",
        "symfony/framework-bundle": "For ControllerBaseTest",
        "symfony/browser-kit": "For ControllerBaseTest"
    },
    "conflict": {
        "symfony/console": "<6.0 || >=9.0",
        "symfony/security-core": "<6.0 || >=9.0",
        "symfony/framework-bundle": "<6.0 || >=9.0",
        "symfony/browser-kit": "<6.0 || >=9.0",
        "doctrine/orm": "<2.11 || >=3.0 <3.1 || >=4.0",
        "doctrine/doctrine-bundle": "<2.5 || >=4.0"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/orm": "^3.1",
        "php-cs-fixer/shim": "^3.88",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^13.0",
        "symfony/browser-kit": "^8.0",
        "symfony/console": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/security-core": "^8.0"
    },
    "scripts": {
        "check": [
            "phpstan analyse --no-progress",
            "php-cs-fixer check --diff",
            "phpunit"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
